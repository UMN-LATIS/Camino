APP_NAME=Camino
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost
FORWARD_SSL_PORT=443

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=camino
DB_USERNAME=sail
DB_PASSWORD=password

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=latistecharch@umn.edu
MAIL_FROM_NAME="UMN Camino"

SHIB_EMULATE=true
SHIB_AUTH_FIELD=unique_id

DEBUGBAR_ENABLED=false

MAPBOX_ACCESS_TOKEN=

# Camino Trekker
VITE_APP_URL="${APP_URL}"
VITE_TREKKER_BASE_DIR=/trekker/
VITE_MAPBOX_ACCESS_TOKEN="${MAPBOX_ACCESS_TOKEN}"

# Xdebug
# SAIL_XDEBUG_MODE=develop,debug,coverage

